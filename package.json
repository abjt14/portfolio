{
  "name": "portfolio",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.5.2",
  "scripts": {
    "dev": "pnpm build:workers && next dev --turbopack",
    "build": "pnpm build:workers && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit && tsc -p src/workers --noEmit",
    "build:workers": "tsc -p src/workers"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.17",
    "@uidotdev/usehooks": "^2.4.1",
    "@vercel/analytics": "^1.2.2",
    "@vercel/speed-insights": "^1.0.10",
    "clsx": "^2.1.0",
    "geist": "^1.2.2",
    "js-cookie": "^3.0.5",
    "motion": "^13.1.0",
    "next": "16.3.0",
    "next-mdx-remote": "^6.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-tweet": "^3.2.1",
    "sharp": "^0.33.2",
    "shiki": "^4.4.3",
    "use-sound": "^4.0.1"
  },
  "devDependencies": {
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.0.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "postcss": "^8",
    "tailwindcss": "^3.3.0",
    "typescript": "^6.0.3"
  },
  "pnpm": {
